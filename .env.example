# Floorfi env — dry-run is the default. Flip mainnet only when on-chain wiring is live.

# true (default) = simulate signatures, label mock receipts as demo
NEXT_PUBLIC_DRY_RUN=true

# true = production mode: no fake sweeps, live RPC / indexer required
# Live pump.fun creates require this (pump.fun is mainnet).
NEXT_PUBLIC_MAINNET=false

# Solana RPC (Helius recommended). Devnet used when not on mainnet.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Server-side indexer / floor APIs (optional in Phase 1; mock fallback if empty)
HELIUS_API_KEY=
MAGIC_EDEN_API=

# Public collection sweep wallet (80% of creator fees). Required for live launch.
# Do not use demo/fake collection addresses — SOL sent there is gone.
NEXT_PUBLIC_SWEEP_WALLET=

# 20% protocol fee destination (pubkey). Required for live launch.
NEXT_PUBLIC_PROTOCOL_FEE_WALLET=

# Explorer base for receipt chips
NEXT_PUBLIC_SOLSCAN_BASE=https://solscan.io
